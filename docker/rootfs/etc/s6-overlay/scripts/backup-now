#!/bin/sh
# One database backup (ARCHITECTURE.md §16): pg_dump custom format into /config/backups,
# written as the postgres user (RLS means only a superuser sees every row), then rotation:
# keep the 7 newest backups plus the newest from each of the last 4 weeks.
# Runs as postgres; started as root (e.g. `docker exec`), it re-runs itself as postgres.
export PATH="/command:/usr/lib/postgresql/18/bin:$PATH"
if [ "$(id -u)" = 0 ]; then
  exec s6-setuidgid postgres "$0" "$@"
fi
set -eu
PG_SOCKET_DIR=/run/postgresql

dir=/config/backups
stamp="$(date -u +%Y%m%d-%H%M%S)"
tmp="$dir/.planhaven-$stamp.dump.tmp"
final="$dir/planhaven-$stamp.dump"

if ! pg_dump --format=custom --compress=6 \
    -h "$PG_SOCKET_DIR" -U postgres -d planhaven -f "$tmp"; then
  rm -f "$tmp"
  echo "planhaven: backup FAILED" >&2
  exit 1
fi
chmod 600 "$tmp"
mv "$tmp" "$final"
echo "planhaven: backup written: $(basename "$final")"

# Rotation. Names sort by time (glob order); weekly = newest backup of each ISO week.
newest_first="$(for f in "$dir"/planhaven-*.dump; do [ -e "$f" ] && printf '%s\n' "$f"; done | sort -r)"
keep="$(printf '%s\n' "$newest_first" | head -n 7)"
weekly="$(printf '%s\n' "$newest_first" | while read -r f; do
  [ -n "$f" ] || continue
  d="$(basename "$f" | cut -c11-18)"
  printf '%s %s\n' "$(date -u -d "$d" +%G-%V 2>/dev/null)" "$f"
done | awk '!seen[$1]++ {print $2}' | head -n 4)"
printf '%s\n' "$newest_first" | while read -r f; do
  [ -n "$f" ] || continue
  case "
$keep
$weekly
" in
    *"
$f
"*) ;;
    *) rm -f "$f" ;;
  esac
done
