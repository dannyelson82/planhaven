#!/command/with-contenv sh
# Wait for PostgreSQL, then create the database, roles and extensions if missing (idempotent).
# Row-Level Security and grants on tables are set up by migrations (ARCHITECTURE.md §8.3).
. /etc/s6-overlay/scripts/common.sh

i=0
until as_postgres pg_isready -q -h "$PG_SOCKET_DIR" -U postgres; do
  i=$((i + 1))
  [ "$i" -le 60 ] || { echo "planhaven: PostgreSQL did not become ready" >&2; exit 1; }
  sleep 1
done

as_postgres psql -h "$PG_SOCKET_DIR" -U postgres -d postgres -v ON_ERROR_STOP=1 -q \
  -f /etc/planhaven/bootstrap-cluster.sql
as_postgres psql -h "$PG_SOCKET_DIR" -U postgres -d planhaven -v ON_ERROR_STOP=1 -q \
  -f /etc/planhaven/bootstrap-database.sql
