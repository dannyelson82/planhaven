#!/command/with-contenv sh
# Prepare volumes and runtime directories (runs as root, before privileges are dropped).
. /etc/s6-overlay/scripts/common.sh

pg_uid="$(id -u postgres)"
pg_gid="$(id -g postgres)"

# /config is root-owned so the app can't rename or replace its entries (e.g. swap pgdata for
# a directory it controls). Others may only traverse: postgres and the app reach their own
# subdirectories.
own_dir /config         0 0 0711
own_dir /config/secrets "$PUID" "$PGID" 0700
own_dir /config/logs    "$PUID" "$PGID" 0750
# Backups are written by the postgres user (they contain every row) and readable only by it.
own_dir /config/backups "$pg_uid" "$pg_gid" 0700
own_dir /config/plugins "$PUID" "$PGID" 0750
# Database files made under a different postgres user ID (an image whose IDs differed) would
# be unreadable: give everything inside back to this image's postgres user. -h and -R without
# -L never follow symlinks; /config is root-owned, so the app can't plant a link here.
for dir in "$PGDATA" /config/backups; do
  if [ -e "$dir/PG_VERSION" ] || [ "$dir" = /config/backups ]; then
    if find "$dir" -mindepth 1 \( ! -uid "$pg_uid" -o ! -gid "$pg_gid" \) -print -quit | grep -q .; then
      echo "planhaven: giving $dir back to the postgres user ($pg_uid:$pg_gid)"
      chown -R -h "$pg_uid:$pg_gid" "$dir"
    fi
  fi
done
own_dir "$PGDATA"       "$pg_uid" "$pg_gid" 0700
own_dir /data           "$PUID" "$PGID" 0750

# Socket directory: only postgres and the app group may connect (see pg_hba.conf).
own_dir "$PG_SOCKET_DIR" "$pg_uid" "$PGID" 0750
