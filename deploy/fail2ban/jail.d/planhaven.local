# fail2ban jail for Planhaven. Adjust logpath to where /config is mounted on the host.
# The ban must happen where the attacker's real address is visible: normally on the reverse
# proxy host. Behind a CDN or tunnel, ban at that layer instead (e.g. CrowdSec + bouncer).
[planhaven]
enabled  = true
filter   = planhaven
logpath  = /path/to/appdata/planhaven/logs/security.log
maxretry = 10
findtime = 10m
bantime  = 1h
